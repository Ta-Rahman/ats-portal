# Entwicklungswerte – nur für die lokale Umgebung. Kopieren nach .env
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats_dev_passwort
POSTGRES_DB=ats

# Host-Ports (alle nur an 127.0.0.1 gebunden). Die API hat keinen eigenen Port, sie ist nur über
# die Web-Oberfläche erreichbar: http://localhost:8090/api/…
DB_HOST_PORT=5434
WEB_HOST_PORT=8090

# Anmeldung interner Nutzer (Iteration 3)
# Schlüssel zum Signieren des Sitzungs-Cookies, mindestens 32 Zeichen. Nur Entwicklungswert –
# in Produktion neu erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=nur-fuer-die-lokale-entwicklung-ats-portal-2026
# Secure-Flag des Sitzungs-Cookies: lokal über http "false", in Produktion hinter HTTPS "true"
COOKIE_SECURE=false
# Leerlauf-Timeout und absolutes Timeout der Sitzung in Sekunden (30 min, 8 h)
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# Löschlauf (Iteration 4): täglicher Lauf im api-Container um diese Uhrzeit in UTC ("off" = aus);
# kein Lauf beim Start. Manuell: docker compose exec -T api npm run -s loeschlauf
DELETION_RUN_TIME=03:30
# Verwaiste Dateien (ohne Anhang-Zeile) werden erst gelöscht, wenn sie älter sind (Sekunden)
DELETION_ORPHAN_GRACE_SECONDS=3600

# Zugriffsprotokoll der API (Methode, Pfad mit maskiertem Token, Status, Dauer, Nutzer-ID)
REQUEST_LOG=true

# Rate-Limits (Iteration 4) als "Anzahl/Sekunden"; Überschreitung → 429 mit Retry-After
# Anmeldung je IP (alle Versuche) und je IP + E-Mail (nur fehlgeschlagene Versuche)
RATE_LIMIT_LOGIN_IP=20/60
RATE_LIMIT_LOGIN_ACCOUNT=10/900
# Bewerbung absenden, Status-Link abrufen, Bewerbung zurückziehen (je IP)
RATE_LIMIT_APPLY=10/3600
RATE_LIMIT_STATUS=30/60
RATE_LIMIT_WITHDRAW=10/900
